# Database configuration (Hostinger MySQL or local MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Resend API (legacy/optional fallback)
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
CONTACT_TO_EMAIL=info@mhtechin.com

# SMTP Core configuration (used for login verification and subscriptions)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=subscriptions@mhtechin.com
SMTP_PASS=your_smtp_password
SMTP_FROM="MHTECHIN Subscriptions <subscriptions@mhtechin.com>"
